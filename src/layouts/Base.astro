---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/jost';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import type { Lang } from '../config/site';
import { t, asset, menuPath } from '../i18n';

interface Props { lang: Lang; title?: string; description?: string; noindex?: boolean; app?: boolean }
const { lang, title, description, noindex = false, app = false } = Astro.props;
const d = t(lang);
const pageTitle = title ?? d.metaTitle;
const desc = description ?? d.metaDesc;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={d.htmlLang} class:list={{ 'is-app': app }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#100c0a" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(menuPath('es'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(menuPath('en'), Astro.site)} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
