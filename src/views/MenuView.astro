---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/menu.css';
import Deco from '../components/Deco.astro';
import Icon from '../components/Icon.astro';
import Sparkle from '../components/Sparkle.astro';
import DiamondRule from '../components/DiamondRule.astro';
import GlassLine from '../components/GlassLine.astro';
import Monogram from '../components/Monogram.astro';
import Filigree from '../components/Filigree.astro';
import { getCocktails, recipeLine, ingredientList, orderables } from '../utils/menu';
import { bar } from '../data/bar';
import { site, type Lang } from '../config/site';
import { t, tx, menuPath, formatPrice } from '../i18n';
import logo from '../assets/logo.webp';
import sirenas from '../assets/sirenas.png';
import esquina from '../assets/esquina.png';
import chandelier from '../assets/chandelier.webp';
import pasillo from '../assets/pasillo.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const cocktails = await getCocktails();
const N = cocktails.length;
const pad = (n: number) => String(n).padStart(2, '0');
const filters = (['citrus', 'sweet', 'fruity', 'bubbly', 'spicy', 'coffee', 'fresh', 'creamy', 'smooth'] as const).filter((k) =>
  cocktails.some((c) => c.data.taste.includes(k)),
);
const chand = await getImage({ src: chandelier, width: 380, format: 'webp' });
const hall = await getImage({ src: pasillo, width: 960, format: 'webp' });
const corner = await getImage({ src: esquina, width: 172, format: 'webp' });
const barGlass = { vinos: 'wine', espumosos: 'flute', cervezas: 'beer' } as const;

const data = {
  lang,
  locale: d.htmlLang,
  currency: site.currency,
  colors: cocktails.map((c) => c.data.color),
  ids: cocktails.map((c) => c.id),
  items: orderables(cocktails, lang),
  s: {
    items: [d.order.items(1), d.order.items(2).replace('2', '{n}')],
    esItems: [t('es').order.items(1), t('es').order.items(2).replace('2', '{n}')],
    remove: d.order.remove,
    add: d.add,
    confirmClear: d.order.confirmClear,
  },
};
---
<Base lang={lang} app>
  <script is:inline slot="head" define:vars={{ en: lang === 'es' ? menuPath('en') : '' }}>
    (function () {
      var h = document.documentElement;
      try {
        if (en && !localStorage.getItem('stz-lang') && /^en\b/i.test(navigator.language || '')) { location.replace(en + location.hash); return; }
        if (sessionStorage.getItem('stz-in') || location.hash) h.classList.add('in');
      } catch (e) {}
      h.classList.add('js');
    })();
  </script>

  <div class="app" id="app" data-section="cocktails">
    <div class="grain" aria-hidden="true"></div>

    <!-- Cover: shown once per visit. -->
    <section class="cover" id="cover" aria-label={site.fullName}>
      <div class="cover-light" aria-hidden="true"></div>
      <div class="hall" id="hall" aria-hidden="true">
        <span class="vp" id="vp"></span>
        <svg id="hallLines" preserveAspectRatio="none"></svg>
        {[0, 1, 2, 3, 4].map((k) => <img class="ch" src={chand.src} alt="" decoding="async" fetchpriority={k === 0 ? 'high' : 'low'} />)}
      </div>
      <div class="frame" aria-hidden="true" style={`--corner:url(${corner.src})`}><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
      <Sparkle class="spark s1" size={22} />
      <Sparkle class="spark s2" size={14} />
      <div class="cover-mid">
        <div class="logo-wrap">
          <Image class="ghost" src={sirenas} alt="" widths={[400, 720]} sizes="360px" loading="eager" />
          <Image class="logo" src={logo} alt={site.fullName} widths={[280, 520]} sizes="260px" loading="eager" />
        </div>
        <p class="welcome italic">{d.welcome}</p>
        <DiamondRule class="cover-rule" label={d.carta} />
        <p class="label offer">{d.offer}</p>
      </div>
      <button class="btn btn-solid open" id="open" type="button">
        {d.open}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
      <p class="label where">{site.area}</p>
    </section>

    <header class="top">
      <div class="top-row">
        <a href={menuPath(lang)} class="brand" aria-label={site.fullName}>
          <Image src={logo} alt="" widths={[100, 200]} sizes="96px" loading="eager" />
        </a>
        <a class="lang label" href={menuPath(other)} data-lang={other} hreflang={other} aria-label={d.switchAria}>{d.switchLabel}</a>
      </div>
      <nav class="tabs" role="tablist" aria-label={site.name}>
        <button class="tab label" role="tab" type="button" data-tab="cocktails" aria-selected="true" aria-controls="cocktailsPanel">{d.tabs.cocktails}</button>
        <span class="tab-dot" aria-hidden="true">◆</span>
        <button class="tab label" role="tab" type="button" data-tab="bar" aria-selected="false" aria-controls="barPanel">{d.tabs.bar}</button>
        <span class="tab-dot" aria-hidden="true">◆</span>
        <button class="tab label" role="tab" type="button" data-tab="pasta" aria-selected="false" aria-controls="pastaPanel">{d.tabs.pasta}</button>
      </nav>
    </header>

    <main class="main" id="main">
      <!-- Cocktails: the printed menu. -->
      <section class="panel" id="cocktailsPanel" role="tabpanel" aria-label={d.tabs.cocktails}>
        <header class="sec-head">
          <GlassLine glass="martini" size={34} class="sec-glass" />
          <div class="sec-title">
            <Sparkle size={14} />
            <h1 class="caps foil">{d.tabs.cocktails}</h1>
            <Sparkle size={14} />
          </div>
          <p class="label sec-sub">{d.houseNote}</p>
        </header>

        <div class="mood">
          <p class="italic">{d.mood}</p>
          <div class="chips" role="group" aria-label={d.mood}>
            <button type="button" data-filter="" aria-pressed="true">{d.all}</button>
            {filters.map((k) => <button type="button" data-filter={k} aria-pressed="false">{d.taste[k]}</button>)}
          </div>
        </div>

        <ul class="menu-list">
          {cocktails.map((c, i) => (
            <>
              {(i === 0 || cocktails[i - 1].data.group !== c.data.group) && (
                <DiamondRule as="li" class="grp" label={d.group[c.data.group]} data-group={c.data.group} />
              )}
              <li class:list={['item', { soldout: !c.data.available }]} data-taste={c.data.taste.join(' ')} data-group={c.data.group} style={`--i:${i}`}>
                <button type="button" class="item-open" data-open={c.id} aria-label={d.details(c.data.name)}>
                  <span class="item-top">
                    <span class="item-name caps">{c.data.name}</span>
                    <span class="lead" aria-hidden="true"></span>
                    <span class="price">{c.data.available ? formatPrice(c.data.price, lang) : d.soldOut}</span>
                  </span>
                  <span class="item-ing">{ingredientList(c, lang)}</span>
                  <span class="item-tags label">{c.data.taste.map((k) => d.taste[k]).join(' · ')}</span>
                </button>
                <button type="button" class="item-add" data-add={c.id} aria-label={d.addAria(c.data.name)} disabled={!c.data.available}>
                  <span class="plus" aria-hidden="true">+</span><span class="n" aria-hidden="true"></span>
                </button>
              </li>
            </>
          ))}
          <li class="empty" data-empty hidden>{d.none}</li>
        </ul>

        <footer class="sign">
          <Image src={sirenas} alt="" widths={[240]} sizes="120px" loading="lazy" />
          <span class="label">{d.cheers}</span>
          <p>{d.footer}</p>
        </footer>
      </section>

      <!-- Wine & beer: boxed tables. -->
      <section class="panel bar-panel" id="barPanel" role="tabpanel" aria-label={d.tabs.bar} hidden>
        <header class="sec-head">
          <Monogram size={46} class="sec-mono" />
          <div class="sec-title">
            <Sparkle size={14} />
            <h2 class="caps foil">{d.tabs.bar}</h2>
            <Sparkle size={14} />
          </div>
          <p class="label sec-sub">{d.barNote}</p>
        </header>
        {bar.map((sec) => (
          <section class="box">
            <header class="box-head">
              <GlassLine glass={barGlass[sec.id as keyof typeof barGlass] ?? 'wine'} size={16} />
              <h3 class="caps">{tx(sec.title, lang)}</h3>
              {sec.note && <span class="label">{tx(sec.note, lang)}</span>}
            </header>
            {sec.groups.map((g) => (
              <>
                {g.title && (
                  <div class:list={['box-sub', { two: g.cols }]}>
                    <span class="label">{tx(g.title, lang)}</span>
                    {g.cols && <><span class="label col">{d.glass}</span><span class="label col">{d.bottle}</span></>}
                  </div>
                )}
                <ul>
                  {g.items.map((it) => {
                    const prices: [string, number, string][] = it.price != null ? [[`${sec.id}:${it.id}`, it.price, '']] : [
                      ...(it.glass != null ? [[`${sec.id}:${it.id}:copa`, it.glass, d.glass] as [string, number, string]] : []),
                      ...(it.bottle != null ? [[`${sec.id}:${it.id}:botella`, it.bottle, d.bottle] as [string, number, string]] : []),
                    ];
                    return (
                      <li class:list={['row', { two: g.cols }]}>
                        <span class="n">{it.name}{it.origin && <small>{tx(it.origin, lang)}</small>}</span>
                        {prices.map(([id, p, unit]) => (
                          <button type="button" class="p" data-add={id} aria-label={d.addAria(`${it.name}${unit ? ` (${unit})` : ''}`)}>
                            <span class="price">{formatPrice(p, lang)}</span>
                            <span class="dot" aria-hidden="true"><span class="plus">+</span><span class="n"></span></span>
                          </button>
                        ))}
                      </li>
                    );
                  })}
                </ul>
              </>
            ))}
          </section>
        ))}
        <footer class="sign">
          <Monogram size={40} />
          <span class="label">{d.cheers}</span>
          <p>{d.footer}</p>
        </footer>
      </section>

      <section class="panel pasta-panel" id="pastaPanel" role="tabpanel" aria-label={d.tabs.pasta} hidden>
        <div class="pasta-photo" style={`--img:url(${hall.src})`} aria-hidden="true"></div>
        <div class="pasta-in">
          <p class="amp" aria-hidden="true"><span class="italic foil">&amp;</span><span class="caps">Pasta</span></p>
          <DiamondRule />
          <p class="pasta-text">{d.pasta.text}</p>
          <span class="soon label">{d.pasta.soon}</span>
        </div>
      </section>
    </main>

    <button class="orderbar" id="orderbar" type="button" data-open-order hidden>
      <span class="ob-n" data-ob-count></span>
      <span class="label ob-label">{d.order.bar}</span>
      <span class="price ob-total" data-ob-total></span>
    </button>

    <div class="pour" id="pour" aria-hidden="true">
      <svg viewBox="0 0 120 150">
        <defs>
          <clipPath id="bowl"><path d="M16 40 C18 74, 102 74, 104 40 Z" /></clipPath>
          <linearGradient id="drink" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e2a35a" /><stop offset="1" stop-color="#8e2230" /></linearGradient>
        </defs>
        <g clip-path="url(#bowl)">
          <g class="liquid"><rect x="0" y="44" width="120" height="40" fill="url(#drink)" /><ellipse cx="60" cy="44" rx="46" ry="3" fill="#f3d39a" opacity=".6" /></g>
        </g>
        <path d="M16 40 C18 74, 102 74, 104 40" fill="none" stroke="#c9a55c" stroke-width="2" />
        <ellipse cx="60" cy="40" rx="44" ry="4.5" fill="none" stroke="#c9a55c" stroke-width="2" />
        <path d="M60 67 V128" stroke="#c9a55c" stroke-width="2.4" stroke-linecap="round" />
        <ellipse cx="60" cy="130" rx="24" ry="4" fill="none" stroke="#c9a55c" stroke-width="2" />
        <g class="garnish"><circle cx="94" cy="33" r="7" fill="#7f1424" stroke="#f3e6cf" stroke-width="1.2" /><path d="M94 26 Q97 18 103 15" stroke="#f3e6cf" stroke-width="1.2" fill="none" /></g>
      </svg>
      <span class="label">{d.preparing}</span>
    </div>
  </div>

  <!-- Drink detail: one card per drink, swipe between them. -->
  <dialog class="detail" id="detail" aria-label={d.tabs.cocktails}>
    <div class="room" aria-hidden="true"></div>
    <div class="detail-top">
      <button type="button" class="back label" data-close><Icon name="back" size={16} />{d.backToMenu}</button>
      <button type="button" class="mini-order label" data-open-order hidden><span data-ob-count></span><Icon name="bag" size={16} /></button>
    </div>
    <div class="pager">
      <div class="dots" aria-hidden="true">{cocktails.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
      <div class="step">
        <button type="button" class="arrow" data-step="-1" aria-label={d.prev}><Icon name="back" size={16} /></button>
        <span class="label count" aria-live="polite"><span id="cur">01</span> / {pad(N)}</span>
        <button type="button" class="arrow" data-step="1" aria-label={d.next}><Icon name="arrow" size={16} /></button>
      </div>
    </div>
    <div class="track" id="track">
      {cocktails.map((c, i) => {
        const v = c.data;
        const base = v.base.map((w) => tx(w, lang));
        return (
          <article class:list={['card', { soldout: !v.available }]} id={`c-${c.id}`} data-id={c.id} aria-roledescription="slide" aria-label={`${v.name}, ${i + 1} / ${N}`}>
            <div class="stage">
              {v.photo ? (
                <Image class="glass" src={v.photo} alt={`${v.name}: ${recipeLine(c, lang)}`} widths={[240, 360, 520]} sizes="(max-width: 480px) 46vw, 220px" loading="lazy" style={`--h:${v.scale}`} />
              ) : (
                <div class="recipe">
                  <Deco />
                  <GlassLine glass={v.glass} size={40} class="recipe-glass" />
                  <p class="base caps">{base.join(' & ')}</p>
                  <span class="label by">{v.mix === 'infused' ? (base.length > 1 ? d.infusedN : d.infused1) : d.with}</span>
                  <ul class="inf">{v.adds.map((a) => <li>{tx(a, lang)}</li>)}</ul>
                </div>
              )}
            </div>
            <div class="info">
              <DiamondRule label={!v.available ? d.soldOut : d.group[v.group]} />
              <h2 class="caps">{v.name}</h2>
              <p class="line italic">{tx(v.line, lang)}</p>
              <p class="tags label">{v.taste.map((k) => d.taste[k]).join(' · ')}</p>
              <div class="info-row">
                <span class="price">{formatPrice(v.price, lang)}</span>
                <div class="acts">
                  {v.photo && <button type="button" class="btn btn-line" data-sheet={c.id}>{d.ingredients}</button>}
                  <button type="button" class="btn btn-solid add" data-add={c.id} aria-label={d.addAria(v.name)} disabled={!v.available}>
                    <span class="plus" aria-hidden="true">+</span><span>{d.add}</span><span class="n" aria-hidden="true"></span>
                  </button>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </dialog>

  {cocktails.filter((c) => c.data.photo).map((c) => (
    <dialog class="sheet" id={`s-${c.id}`} aria-labelledby={`sn-${c.id}`}>
      <div class="grab" aria-hidden="true"></div>
      <div class="sheet-head"><h3 class="caps" id={`sn-${c.id}`}>{c.data.name}</h3><span class="price">{formatPrice(c.data.price, lang)}</span></div>
      <DiamondRule label={d.ingredients} />
      <ul class="ing">{[...c.data.base, ...c.data.adds].map((w) => <li>{tx(w, lang)}</li>)}</ul>
      <div class="sheet-acts">
        <button type="button" class="btn btn-solid" data-add={c.id} disabled={!c.data.available}><span class="plus" aria-hidden="true">+</span>{d.addToOrder}<span class="n" aria-hidden="true"></span></button>
        <button type="button" class="btn btn-line" data-close>{d.close}</button>
      </div>
    </dialog>
  ))}

  <dialog class="sheet order-sheet" id="order" aria-labelledby="order-title">
    <div class="grab" aria-hidden="true"></div>
    <div class="sheet-head"><h3 class="caps" id="order-title">{d.order.title}</h3><span class="label" data-order-count></span></div>
    <p class="order-empty" data-order-empty>{d.order.empty}</p>
    <ul class="order-list" data-order-list></ul>
    <div class="order-foot" data-order-foot>
      <div class="order-total"><span class="label">{d.order.total}</span><span class="price" data-order-total></span></div>
      <p class="order-note">{d.order.note}</p>
      <button type="button" class="btn btn-solid big" data-show-bartender>{d.order.show}</button>
      <div class="order-more">
        <button type="button" class="link label" data-clear-order>{d.order.clear}</button>
        <button type="button" class="link label" data-close>{d.close}</button>
      </div>
    </div>
  </dialog>

  <dialog class="bartender" id="bartender" aria-labelledby="bt-title">
    <div class="bt-inner">
      <Filigree class="bt-fil" />
      <div class="bt-head">
        <Monogram size={40} />
        <p class="label bt-hint">{d.order.bartenderHint}</p>
        <h2 class="caps" id="bt-title">{d.order.bartenderTitle}</h2>
      </div>
      <ul class="bt-list" data-bt-list></ul>
      <div class="bt-total"><span class="label" data-bt-count></span><span class="price" data-bt-total></span></div>
      <button type="button" class="btn bt-back" data-close>{d.order.back}</button>
    </div>
  </dialog>

  <script type="application/json" id="menu-data" set:html={JSON.stringify(data)} />
  <script>
    import '../scripts/menu';
  </script>
</Base>
