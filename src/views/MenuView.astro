---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/menu.css';
import Deco from '../components/Deco.astro';
import Icon from '../components/Icon.astro';
import { getCocktails, recipeLine, orderables } from '../utils/menu';
import { bar } from '../data/bar';
import { tastes } from '../content.config';
import { site, type Lang } from '../config/site';
import { t, tx, menuPath, formatPrice } from '../i18n';
import logo from '../assets/logo.webp';
import sirenas from '../assets/sirenas.png';
import esquina from '../assets/esquina.png';
import chandelier from '../assets/chandelier.webp';
import pasillo from '../assets/pasillo.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const cocktails = await getCocktails();
const N = cocktails.length;
const pad = (n: number) => String(n).padStart(2, '0');
const filters = (['citrus', 'sweet', 'fruity', 'bubbly', 'spicy', 'coffee', 'fresh', 'creamy', 'smooth'] as const).filter((k) =>
  cocktails.some((c) => c.data.taste.includes(k)),
);
void tastes;

const chand = await getImage({ src: chandelier, width: 380, format: 'webp' });
const hall = await getImage({ src: pasillo, width: 960, format: 'webp' });
const corner = await getImage({ src: esquina, width: 172, format: 'webp' });

const data = {
  lang,
  locale: d.htmlLang,
  currency: site.currency,
  colors: cocktails.map((c) => c.data.color),
  ids: cocktails.map((c) => c.id),
  items: orderables(cocktails, lang),
  s: {
    items: [d.order.items(1), d.order.items(2).replace('2', '{n}')],
    esItems: [t('es').order.items(1), t('es').order.items(2).replace('2', '{n}')],
    remove: d.order.remove,
    add: d.add,
    confirmClear: d.order.confirmClear,
    list: d.view.list,
    cards: d.view.cards,
  },
};
---
<Base lang={lang} app>
  <script is:inline slot="head" define:vars={{ en: lang === 'es' ? menuPath('en') : '' }}>
    (function () {
      var h = document.documentElement;
      try {
        if (en && !localStorage.getItem('stz-lang') && /^en\b/i.test(navigator.language || '')) { location.replace(en + location.hash); return; }
        if (sessionStorage.getItem('stz-in') || location.hash) h.classList.add('in');
      } catch (e) {}
    })();
  </script>

  <div class="app" id="app" style={`--c1:${cocktails[0].data.color}`}>
    <div class="room" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <!-- Cover: the first thing a guest sees after scanning. Shown once per visit. -->
    <section class="cover" id="cover" aria-label={site.fullName}>
      <div class="cover-light" aria-hidden="true"></div>
      <div class="hall" id="hall" aria-hidden="true">
        <span class="vp" id="vp"></span>
        <svg id="hallLines" preserveAspectRatio="none"></svg>
        {[0, 1, 2, 3, 4].map((k) => <img class="ch" src={chand.src} alt="" decoding="async" fetchpriority={k === 0 ? 'high' : 'low'} />)}
      </div>
      <div class="frame" aria-hidden="true" style={`--corner:url(${corner.src})`}><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
      <div class="cover-mid">
        <div class="logo-wrap">
          <Image class="ghost" src={sirenas} alt="" widths={[400, 720]} sizes="360px" loading="eager" />
          <Image class="logo" src={logo} alt={site.fullName} widths={[280, 520]} sizes="260px" loading="eager" />
        </div>
        <p class="welcome display">{d.welcome}</p>
        <p class="mono offer">{d.offer}</p>
      </div>
      <button class="pill pill-solid open" id="open" type="button">
        {d.open}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
      <p class="mono where">{site.area}</p>
    </section>

    <header class="top">
      <div class="top-row">
        <a href={menuPath(lang)} class="brand" aria-label={site.fullName}>
          <Image src={logo} alt="" widths={[100, 200]} sizes="96px" loading="eager" />
        </a>
        <div class="top-r">
          <button class="viewtog mono" id="viewTog" type="button" aria-pressed="false">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" class="ic-list"><path d="M2 4h12M2 8h12M2 12h12" /></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" class="ic-cards"><rect x="3" y="2" width="10" height="12" rx="1.5" /></svg>
            <span id="viewLbl">{d.view.list}</span>
          </button>
          <a class="lang mono" href={menuPath(other)} data-lang={other} hreflang={other} aria-label={d.switchAria}>{d.switchLabel}</a>
        </div>
      </div>
      <nav class="tabs" role="tablist" aria-label={site.name}>
        <button class="tab display" role="tab" type="button" data-tab="cocktails" aria-selected="true" aria-controls="cocktails">{d.tabs.cocktails}</button>
        <button class="tab display" role="tab" type="button" data-tab="bar" aria-selected="false" aria-controls="barPanel">{d.tabs.bar}</button>
        <button class="tab display" role="tab" type="button" data-tab="pasta" aria-selected="false" aria-controls="pastaPanel">{d.tabs.pasta}</button>
      </nav>
    </header>

    <main class="main" id="main">
      <!-- One drink per card, swipe like turning pages. -->
      <section class="cocktails" id="cocktails" aria-roledescription="carousel" aria-label={d.tabs.cocktails}>
        <div class="pager">
          <div class="dots" aria-hidden="true">{cocktails.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
          <div class="step">
            <button type="button" class="arrow" data-step="-1" aria-label={d.prev}><Icon name="back" size={16} /></button>
            <span class="mono count" aria-live="polite"><span id="cur">01</span> / {pad(N)}</span>
            <button type="button" class="arrow" data-step="1" aria-label={d.next}><Icon name="arrow" size={16} /></button>
          </div>
        </div>
        <div class="track" id="track">
          {cocktails.map((c, i) => {
            const v = c.data;
            const base = v.base.map((w) => tx(w, lang));
            return (
              <article class:list={['card', { soldout: !v.available }]} id={`c-${c.id}`} data-id={c.id} aria-roledescription="slide" aria-label={`${v.name}, ${i + 1} / ${N}`}>
                <div class="stage">
                  {v.photo ? (
                    <Image class="glass" src={v.photo} alt={`${v.name}: ${recipeLine(c, lang)}`} widths={[240, 360, 520]} sizes="(max-width: 480px) 46vw, 220px" loading={i < 2 ? 'eager' : 'lazy'} style={`--h:${v.scale}`} />
                  ) : (
                    <div class="recipe">
                      <Deco />
                      <p class="base display">{base.join(' & ')}</p>
                      <span class="mono by">{v.mix === 'infused' ? (base.length > 1 ? d.infusedN : d.infused1) : d.with}</span>
                      <ul class="inf">{v.adds.map((a) => <li>{tx(a, lang)}</li>)}</ul>
                    </div>
                  )}
                </div>
                <div class="info">
                  <span class="mono grp">{!v.available ? d.soldOut : d.group[v.group]}</span>
                  <h2 class="display">{v.name}</h2>
                  <p class="line">{tx(v.line, lang)}</p>
                  <div class="taste">{v.taste.map((k) => <span>{d.taste[k]}</span>)}</div>
                  <div class="info-row">
                    <span class="price">{formatPrice(v.price, lang)}</span>
                    <div class="acts">
                      {v.photo && <button type="button" class="pill pill-line" data-sheet={c.id}>{d.ingredients}</button>}
                      <button type="button" class="pill pill-solid add" data-add={c.id} aria-label={d.addAria(v.name)} disabled={!v.available}>
                        <span class="plus" aria-hidden="true">+</span><span>{d.add}</span><span class="n" aria-hidden="true"></span>
                      </button>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="panel list-panel" id="listPanel" aria-label={d.view.list} hidden>
        <div class="mood">
          <p class="display">{d.mood}</p>
          <div class="chips" role="group" aria-label={d.mood}>
            <button type="button" data-filter="" aria-pressed="true">{d.all}</button>
            {filters.map((k) => <button type="button" data-filter={k} aria-pressed="false">{d.taste[k]}</button>)}
          </div>
        </div>
        <ul class="list">
          {cocktails.map((c, i) => (
            <>
              {(i === 0 || cocktails[i - 1].data.group !== c.data.group) && <li class="grp-h mono" data-group={c.data.group}>{d.group[c.data.group]}</li>}
              <li class="row" data-taste={c.data.taste.join(' ')} data-group={c.data.group}>
                <button type="button" class="row-open" data-goto={c.id}>
                  <span class="th">
                    {c.data.photo ? <Image src={c.data.photo} alt="" widths={[64, 128]} sizes="48px" loading="lazy" /> : <span class="sw" style={`--a:${c.data.color}`}></span>}
                  </span>
                  <span class="row-text">
                    <span class="row-name display">{c.data.name}</span>
                    <span class="row-rec">{recipeLine(c, lang)}</span>
                  </span>
                  <span class="price">{formatPrice(c.data.price, lang)}</span>
                </button>
                <button type="button" class="row-add" data-add={c.id} aria-label={d.addAria(c.data.name)} disabled={!c.data.available}>
                  <span class="plus" aria-hidden="true">+</span><span class="n" aria-hidden="true"></span>
                </button>
              </li>
            </>
          ))}
          <li class="empty" data-empty hidden>{d.none}</li>
        </ul>
      </section>

      <section class="panel bar-panel" id="barPanel" role="tabpanel" aria-label={d.tabs.bar} hidden>
        {bar.map((sec) => (
          <section class="bar-sec">
            <h2 class="display">{tx(sec.title, lang)}{sec.note && <span class="mono">{tx(sec.note, lang)}</span>}</h2>
            {sec.groups.map((g) => (
              <>
                {g.title ? (
                  <div class="sub mono">
                    <span>{tx(g.title, lang)}</span>
                    {g.cols && <span class="cols"><span>{d.glass}</span><span>{d.bottle}</span></span>}
                  </div>
                ) : <div class="sub-gap"></div>}
                <ul>
                  {g.items.map((it) => {
                    const prices = it.price != null ? [[`${sec.id}:${it.id}`, it.price, '']] : [
                      ...(it.glass != null ? [[`${sec.id}:${it.id}:copa`, it.glass, d.glass]] : []),
                      ...(it.bottle != null ? [[`${sec.id}:${it.id}:botella`, it.bottle, d.bottle]] : []),
                    ];
                    return (
                      <li class:list={{ two: g.cols }}>
                        <span class="n">{it.name}{it.origin && <small>{tx(it.origin, lang)}</small>}</span>
                        <span class="lead" aria-hidden="true"></span>
                        {(prices as [string, number, string][]).map(([id, p, unit]) => (
                          <button type="button" class="p" data-add={id} aria-label={d.addAria(`${it.name}${unit ? ` (${unit})` : ''}`)}>
                            <span class="price">{formatPrice(p, lang)}</span>
                            <span class="dot" aria-hidden="true"><span class="plus">+</span><span class="n"></span></span>
                          </button>
                        ))}
                      </li>
                    );
                  })}
                </ul>
              </>
            ))}
          </section>
        ))}
        <div class="sign">
          <Image src={sirenas} alt="" widths={[240]} sizes="120px" loading="lazy" />
          <span class="mono">{d.cheers}</span>
          <p>{d.footer}</p>
        </div>
      </section>

      <section class="panel pasta-panel" id="pastaPanel" role="tabpanel" aria-label={d.tabs.pasta} hidden>
        <div class="pasta-photo" style={`--img:url(${hall.src})`} aria-hidden="true"></div>
        <div class="pasta-in">
          <p class="amp display" aria-hidden="true"><span>&amp;</span><br />pasta</p>
          <p class="pasta-text">{d.pasta.text}</p>
          <span class="soon mono">{d.pasta.soon}</span>
        </div>
      </section>
    </main>

    <button class="orderbar" id="orderbar" type="button" data-open-order hidden>
      <span class="ob-n" data-ob-count></span>
      <span class="mono ob-label">{d.order.bar}</span>
      <span class="price ob-total" data-ob-total></span>
    </button>

    <div class="pour" id="pour" aria-hidden="true">
      <svg viewBox="0 0 120 150">
        <defs>
          <clipPath id="bowl"><path d="M16 40 C18 74, 102 74, 104 40 Z" /></clipPath>
          <linearGradient id="drink" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f0b45a" /><stop offset="1" stop-color="#b9452f" /></linearGradient>
        </defs>
        <g clip-path="url(#bowl)">
          <g class="liquid"><rect x="0" y="44" width="120" height="40" fill="url(#drink)" /><ellipse cx="60" cy="44" rx="46" ry="3" fill="#ffd28a" opacity=".6" /></g>
        </g>
        <path d="M16 40 C18 74, 102 74, 104 40" fill="none" stroke="#b8955a" stroke-width="2" />
        <ellipse cx="60" cy="40" rx="44" ry="4.5" fill="none" stroke="#b8955a" stroke-width="2" />
        <path d="M60 67 V128" stroke="#b8955a" stroke-width="2.4" stroke-linecap="round" />
        <ellipse cx="60" cy="130" rx="24" ry="4" fill="none" stroke="#b8955a" stroke-width="2" />
        <g class="garnish"><circle cx="94" cy="33" r="9" fill="#9cc86a" stroke="#e8f2c8" stroke-width="1.4" /><path d="M94 24v18M85 33h18M88 27l12 12M100 27l-12 12" stroke="#e8f2c8" stroke-width=".8" /></g>
      </svg>
      <span class="mono">{d.preparing}</span>
    </div>
  </div>

  {cocktails.filter((c) => c.data.photo).map((c) => (
    <dialog class="sheet" id={`s-${c.id}`} aria-labelledby={`sn-${c.id}`}>
      <div class="grab" aria-hidden="true"></div>
      <div class="sheet-head"><h3 class="display" id={`sn-${c.id}`}>{c.data.name}</h3><span class="price">{formatPrice(c.data.price, lang)}</span></div>
      <p class="mono sheet-lbl">{d.ingredients}</p>
      <ul class="ing">{[...c.data.base, ...c.data.adds].map((w) => <li>{tx(w, lang)}</li>)}</ul>
      <div class="sheet-acts">
        <button type="button" class="pill pill-solid" data-add={c.id} disabled={!c.data.available}><span class="plus" aria-hidden="true">+</span>{d.addToOrder}<span class="n" aria-hidden="true"></span></button>
        <button type="button" class="pill pill-line" data-close>{d.close}</button>
      </div>
    </dialog>
  ))}

  <dialog class="sheet order-sheet" id="order" aria-labelledby="order-title">
    <div class="grab" aria-hidden="true"></div>
    <div class="sheet-head"><h3 class="display" id="order-title">{d.order.title}</h3><span class="mono" data-order-count></span></div>
    <p class="order-empty" data-order-empty>{d.order.empty}</p>
    <ul class="order-list" data-order-list></ul>
    <div class="order-foot" data-order-foot>
      <div class="order-total"><span class="mono">{d.order.total}</span><span class="price" data-order-total></span></div>
      <p class="order-note">{d.order.note}</p>
      <button type="button" class="pill pill-solid big" data-show-bartender>{d.order.show}</button>
      <div class="order-more">
        <button type="button" class="link mono" data-clear-order>{d.order.clear}</button>
        <button type="button" class="link mono" data-close>{d.close}</button>
      </div>
    </div>
  </dialog>

  <dialog class="bartender" id="bartender" aria-labelledby="bt-title">
    <div class="bt-inner">
      <Deco class="bt-deco" />
      <p class="mono bt-hint">{d.order.bartenderHint}</p>
      <h2 class="display" id="bt-title">{d.order.bartenderTitle}</h2>
      <ul class="bt-list" data-bt-list></ul>
      <div class="bt-total"><span class="mono" data-bt-count></span><span class="price" data-bt-total></span></div>
      <button type="button" class="pill bt-back" data-close>{d.order.back}</button>
    </div>
  </dialog>

  <script type="application/json" id="menu-data" set:html={JSON.stringify(data)} />
  <script>
    import '../scripts/menu';
  </script>
</Base>
