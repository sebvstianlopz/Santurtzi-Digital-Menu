---
/** Four-point sparkle star, as on the vintage cocktail posters. */
interface Props { size?: number; class?: string }
const { size = 16, class: cls } = Astro.props;
---
<svg class:list={['sparkle', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="M12 0C12.5 7.5 16.5 11.5 24 12C16.5 12.5 12.5 16.5 12 24C11.5 16.5 7.5 12.5 0 12C7.5 11.5 11.5 7.5 12 0Z" />
</svg>
