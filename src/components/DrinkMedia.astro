---
import { Image } from 'astro:assets';
import DrinkArt from './DrinkArt.astro';
import type { Drink } from '../utils/drinks';
import type { Lang } from '../config/site';
import { tx } from '../i18n';

interface Props {
  drink: Drink;
  lang: Lang;
  uid: string;
  size: 'card' | 'sheet' | 'mini';
  eager?: boolean;
}
const { drink, lang, uid, size, eager = false } = Astro.props;
const widths = { card: [120, 200, 240], sheet: [480, 720, 960], mini: [96, 160] }[size];
const sizes = { card: '104px', sheet: '(max-width: 640px) 100vw, 560px', mini: '64px' }[size];
---
{drink.data.photo ? (
  <Image
    class="media-img"
    src={drink.data.photo}
    alt={tx(drink.data.name, lang)}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
  />
) : (
  <DrinkArt class="media-img" drink={drink} uid={uid} />
)}
