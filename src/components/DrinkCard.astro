---
import DrinkMedia from './DrinkMedia.astro';
import Strength from './Strength.astro';
import Icon from './Icon.astro';
import type { Drink } from '../utils/drinks';
import type { Lang } from '../config/site';
import { t, tx, formatPrice } from '../i18n';

interface Props { drink: Drink; lang: Lang; eager?: boolean }
const { drink, lang, eager } = Astro.props;
const d = t(lang);
const v = drink.data;
const name = tx(v.name, lang);
---
<article
  class:list={['card', { soldout: !v.available }]}
  data-drink={drink.id}
  data-flavor={v.flavor.join(' ')}
  data-strength={v.strength}
>
  <div class="media card-media">
    <DrinkMedia drink={drink} lang={lang} uid={`c-${drink.id}`} size="card" eager={eager} />
    {!v.available ? (
      <span class="badge soldout">{d.badge.soldOut}</span>
    ) : v.seasonal ? (
      <span class="badge seasonal">{d.badge.seasonal}</span>
    ) : v.signature ? (
      <span class="badge">{d.badge.signature}</span>
    ) : null}
  </div>
  <div class="card-body">
    <div class="card-top">
      <h3 class="card-name serif">
        <a class="hit" href={`#${drink.id}`} data-open={drink.id}>{name}</a>
      </h3>
      <span class="price">{formatPrice(v.price, lang)}</span>
    </div>
    <p class="card-unique">{tx(v.unique, lang)}</p>
    <div class="card-meta">
      <Strength level={v.strength} lang={lang} />
      <span class="flavors">{v.flavor.slice(0, 2).map((f) => d.flavor[f]).join(' · ')}{v.size && ` · ${v.size}`}</span>
    </div>
  </div>
  <button
    class="add"
    type="button"
    data-add={drink.id}
    aria-label={d.addAria(name)}
    disabled={!v.available}
  >
    <Icon name="plus" size={20} class="add-plus" />
    <span class="add-count" aria-hidden="true"></span>
  </button>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 14px;
    padding: 12px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.2s, transform 0.15s var(--ease);
  }
  .card:has(.hit:active) { transform: scale(0.985); }
  @media (hover: hover) { .card:hover { background: var(--surface-2); } }
  .card[hidden] { display: none; }

  .card-media { width: 104px; height: 120px; border-radius: var(--radius-sm); }
  .card-media .badge { position: absolute; left: 6px; top: 6px; height: 20px; font-size: 10px; padding: 0 7px; }

  .card-body { min-width: 0; display: flex; flex-direction: column; gap: 6px; padding: 2px 0 0; }
  .card-top { display: flex; align-items: baseline; gap: 10px; }
  .card-name { flex: 1; font-size: 19px; font-weight: 560; letter-spacing: -0.005em; }
  .card-top .price { font-size: 16px; }
  .hit { text-decoration: none; }
  .hit::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .hit:focus-visible { outline: none; }
  .card:has(.hit:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  .card-unique {
    font-size: 14px; line-height: 1.4; color: var(--muted);
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-meta {
    margin-top: auto;
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px;
    padding-right: 52px;
  }
  .flavors { font-size: 13px; color: var(--muted); font-weight: 600; }

  .add {
    position: absolute; right: 10px; bottom: 10px; z-index: 1;
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border: 0; border-radius: 50%;
    background: var(--surface-3); color: var(--text);
    transition: background-color 0.2s, color 0.2s, transform 0.15s var(--ease);
  }
  .add:active { transform: scale(0.9); }
  .add-count { display: none; font-weight: 800; font-size: 16px; font-variant-numeric: tabular-nums; }
  .add[data-count] { background: var(--accent); color: var(--accent-ink); }
  .add[data-count] :global(.add-plus) { display: none; }
  .add[data-count] .add-count { display: block; }
  .add[disabled] { opacity: 0.35; }
  .add.bump { animation: bump 0.35s var(--ease); }
  @keyframes bump { 40% { transform: scale(1.18); } }

  .soldout .card-media :global(.media-img), .soldout .card-name, .soldout .price { opacity: 0.5; }
  .soldout .price { text-decoration: line-through; }
</style>
