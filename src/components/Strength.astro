---
import type { Lang } from '../config/site';
import { t } from '../i18n';

interface Props { level: number; lang: Lang; showLabel?: boolean }
const { level, lang, showLabel = false } = Astro.props;
const d = t(lang);
---
{level === 0 ? (
  <span class="zero-pill">{d.strength[0]}</span>
) : (
  <span class="strength" title={`${d.strengthLabel}: ${d.strength[level]}`}>
    <span class="dots" aria-hidden="true">
      {[1, 2, 3].map((i) => <i class:list={{ on: i <= level }} />)}
    </span>
    <span class:list={['label', { 'visually-hidden': !showLabel }]}>{showLabel ? d.strength[level] : `${d.strengthLabel}: ${d.strength[level]}`}</span>
  </span>
)}
