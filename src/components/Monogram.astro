---
/** The "S" seal: a ringed monogram used as a section mark. */
interface Props { size?: number; class?: string }
const { size = 44, class: cls } = Astro.props;
---
<svg class:list={['monogram', cls]} width={size} height={size} viewBox="0 0 60 60" aria-hidden="true" focusable="false">
  <circle cx="30" cy="30" r="28.5" fill="none" stroke="currentColor" stroke-width="1" />
  <circle cx="30" cy="30" r="25" fill="none" stroke="currentColor" stroke-width=".6" />
  <path d="M30 2.5 31 5 30 7.5 29 5Z M30 52.5 31 55 30 57.5 29 55Z M2.5 30 5 29 7.5 30 5 31Z M52.5 30 55 29 57.5 30 55 31Z" fill="currentColor" />
  <text x="30" y="40.5" text-anchor="middle" font-family="'Bodoni Moda Variable', Didot, Georgia, serif" font-size="30" fill="currentColor">S</text>
</svg>
