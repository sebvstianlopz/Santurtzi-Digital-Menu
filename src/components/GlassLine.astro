---
/** Line-art glassware in one stroke weight. Stands in for a drink until its photo arrives. */
export type Glass = 'coupe' | 'martini' | 'flute' | 'rocks' | 'highball' | 'wine' | 'beer';
interface Props { glass: Glass; size?: number; class?: string }
const { glass, size = 48, class: cls } = Astro.props;
const shapes: Record<Glass, string> = {
  coupe: `<ellipse cx="30" cy="24" rx="20" ry="2.6"/><path d="M10 24C11 40 19 45 30 45S49 40 50 24"/><path d="M14 31Q30 35 46 31"/><path d="M30 45V78"/><ellipse cx="30" cy="80" rx="12" ry="2.4"/><circle cx="45" cy="21" r="3.4"/><path d="M45 17.6Q46 12 50 10"/>`,
  martini: `<ellipse cx="30" cy="20" rx="22" ry="2.6"/><path d="M8 20 30 46 52 20"/><path d="M14 27H46"/><path d="M30 46V78"/><ellipse cx="30" cy="80" rx="12" ry="2.4"/><path d="M42 6 26 36"/><circle cx="33.5" cy="22" r="3.8"/>`,
  flute: `<ellipse cx="30" cy="8" rx="8" ry="1.8"/><path d="M22 8C21 30 24 48 30 52S39 30 38 8"/><path d="M22.6 18H37.4"/><path d="M30 52V80"/><ellipse cx="30" cy="82" rx="10" ry="2.2"/><circle cx="28" cy="34" r=".9"/><circle cx="31.5" cy="27" r=".9"/><circle cx="29.5" cy="42" r=".9"/>`,
  rocks: `<ellipse cx="30" cy="40" rx="17" ry="2.4"/><path d="M13 40 15.5 80Q16 82 18 82H42Q44 82 44.5 80L47 40"/><path d="M14.4 54H45.6"/><rect x="20" y="57" width="11" height="11" rx="1.5" transform="rotate(-10 25.5 62.5)"/><rect x="30" y="61" width="10" height="10" rx="1.5" transform="rotate(14 35 66)"/><path d="M41 40A7 7 0 0 1 48 31"/><path d="M41 40A7 7 0 0 0 48 47"/>`,
  highball: `<ellipse cx="30" cy="14" rx="12.5" ry="1.9"/><path d="M17.5 14 19.5 82Q20 84 22 84H38Q40 84 40.5 82L42.5 14"/><path d="M18 24H42"/><path d="M36 4 26 70"/><circle cx="27" cy="48" r=".9"/><circle cx="33" cy="58" r=".9"/><circle cx="30" cy="38" r=".9"/>`,
  wine: `<ellipse cx="30" cy="14" rx="13" ry="2"/><path d="M17 14C16 36 20 47 30 48S44 36 43 14"/><path d="M17.6 30Q30 34 42.4 30"/><path d="M30 48V80"/><ellipse cx="30" cy="82" rx="11" ry="2.2"/>`,
  beer: `<ellipse cx="30" cy="12" rx="13" ry="2"/><path d="M17 12 21 82Q21.5 84 23.5 84H36.5Q38.5 84 39 82L43 12"/><path d="M17.4 20Q21 17 24 20T30 20T36 20T42.6 20"/><circle cx="27" cy="50" r=".9"/><circle cx="33" cy="62" r=".9"/><circle cx="30" cy="36" r=".9"/>`,
};
---
<svg class:list={['glassline', cls]} width={size} height={size * 1.5} viewBox="0 0 60 90" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={shapes[glass]} />
