---
/**
 * Illustrated stand-in for a drink photo: the right glass, the drink's colour and its garnish,
 * glowing on the dark menu. Used whenever a drink has no `photo` yet.
 */
import type { Drink } from '../utils/drinks';

interface Props {
  drink: Drink;
  /** Unique per instance on the page (gradients/clip paths need distinct ids). */
  uid: string;
  class?: string;
}
const { drink, uid, class: cls } = Astro.props;
const { glass, color, garnish } = drink.data;

function shade(hex: string, amt: number) {
  const n = parseInt(hex.slice(1), 16);
  const ch = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) =>
    Math.round(amt >= 0 ? c + (255 - c) * amt : c * (1 + amt)),
  );
  return '#' + ch.map((c) => c.toString(16).padStart(2, '0')).join('');
}

type Shape = {
  body: string;
  level: number;
  rim?: [number, number];
  stem?: [number, number];
  base?: [number, number];
  ice?: boolean;
  fizz?: boolean;
  straw?: boolean;
};
const shapes: Record<typeof glass, Shape> = {
  rocks: { body: 'M28 44 L31 84 Q31.5 87 35 87 L65 87 Q68.5 87 69 84 L72 44 Z', level: 56, rim: [69, 45], ice: true },
  highball: { body: 'M35 20 L37.5 85 Q38 88 41 88 L59 88 Q62 88 62.5 85 L65 20 Z', level: 30, rim: [63, 21], ice: true, fizz: true, straw: true },
  coupe: { body: 'M22 36 Q24 58 50 59 Q76 58 78 36 Z', level: 41, rim: [75, 37], stem: [59, 82], base: [84, 14] },
  martini: { body: 'M22 30 L50 58 L78 30 Z', level: 36, rim: [73, 31], stem: [58, 82], base: [84, 14] },
  copa: { body: 'M28 24 Q23 63 50 65 Q77 63 72 24 Z', level: 34, rim: [69, 26], stem: [65, 84], base: [86, 14], ice: true, fizz: true },
  wine: { body: 'M33 20 Q31 57 50 59 Q69 57 67 20 Z', level: 38, rim: [65, 22], stem: [59, 84], base: [86, 13] },
  hurricane: { body: 'M37 20 Q30 39 41 53 Q34 67 40 82 L60 82 Q66 67 59 53 Q70 39 63 20 Z', level: 28, rim: [61, 21], stem: [82, 86], base: [87, 12], straw: true },
  pint: { body: 'M32 14 L37 85 Q37.5 88 41 88 L59 88 Q62.5 88 63 85 L68 14 Z', level: 22, fizz: true },
  bottle: { body: 'M44 9 L56 9 L56 29 Q67 35 67 46 L67 85 Q67 89 63 89 L37 89 Q33 89 33 85 L33 46 Q33 35 44 29 Z', level: 30, fizz: true },
  shot: { body: 'M37 52 L40.5 86 Q41 88 44 88 L56 88 Q59 88 59.5 86 L63 52 Z', level: 58, rim: [60, 53] },
};
const s = shapes[glass];
const id = (k: string) => `${uid}-${k}`;
const top = shade(color, 0.25);
const bottom = shade(color, -0.35);
const [rx, ry] = s.rim ?? [0, 0];
const fruit = { lime: '#9cc94a', lemon: '#f1d54a', orange: '#f08a2b' } as const;
const wheel = garnish === 'lime' || garnish === 'lemon' || garnish === 'orange' ? fruit[garnish] : null;
// Pseudo-random but stable bubble positions per drink.
let seed = [...drink.id].reduce((a, c) => a + c.charCodeAt(0), 0);
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const bubbles = s.fizz ? Array.from({ length: 7 }, () => [40 + rnd() * 20, s.level + 8 + rnd() * 44, 0.6 + rnd() * 0.9]) : [];
---
<svg class={cls} viewBox="0 0 100 100" role="img" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={id('glow')} gradientUnits="userSpaceOnUse" cx="50" cy="62" r="48">
      <stop offset="0" stop-color={color} stop-opacity="0.42" />
      <stop offset="0.6" stop-color={color} stop-opacity="0.08" />
      <stop offset="1" stop-color={color} stop-opacity="0" />
    </radialGradient>
    <linearGradient id={id('liq')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={top} />
      <stop offset="1" stop-color={bottom} />
    </linearGradient>
    <clipPath id={id('clip')}><path d={s.body} /></clipPath>
  </defs>

  <rect x="-100" y="-50" width="300" height="200" fill={`url(#${id('glow')})`} />
  <ellipse cx="50" cy={s.base ? s.base[0] + 3 : 91} rx="24" ry="2.4" fill="#000" opacity="0.35" />

  {s.straw && <path d={`M${rx - 14} ${s.level + 30} L${rx + 4} ${ry - 14}`} stroke="#f3ede4" stroke-opacity="0.8" stroke-width="2.2" stroke-linecap="round" />}

  <g clip-path={`url(#${id('clip')})`}>
    <rect x="0" y={s.level} width="100" height="100" fill={`url(#${id('liq')})`} />
    <rect x="0" y={s.level} width="100" height="1.2" fill="#fff" opacity="0.28" />
    {glass === 'pint' && <rect x="0" y={s.level - 4} width="100" height="7" fill="#f6efe1" opacity="0.92" />}
    {glass === 'bottle' && <rect x="36" y="52" width="28" height="20" rx="2" fill="#f3ede4" opacity="0.9" />}
    {glass === 'bottle' && <rect x="40" y="58" width="20" height="2" rx="1" fill={bottom} opacity="0.7" />}
    {garnish === 'coffee' && <rect x="0" y={s.level - 0.5} width="100" height="4" fill="#c79c74" />}
    {s.ice && (
      <g fill="#fff" fill-opacity="0.14" stroke="#fff" stroke-opacity="0.45" stroke-width="0.8">
        <rect x="38" y={s.level - 3} width="12" height="12" rx="2" transform={`rotate(-12 44 ${s.level + 3})`} />
        <rect x="51" y={s.level + 1} width="11" height="11" rx="2" transform={`rotate(15 56 ${s.level + 6})`} />
      </g>
    )}
    {bubbles.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#fff" opacity="0.45" />)}
    <path d={`M30 10 L34 92`} stroke="#fff" stroke-opacity="0.16" stroke-width="3" />
  </g>

  <path d={s.body} fill="#fff" fill-opacity="0.04" stroke="#f3ede4" stroke-opacity="0.6" stroke-width="1.2" stroke-linejoin="round" />
  {s.stem && <path d={`M50 ${s.stem[0]} L50 ${s.stem[1]}`} stroke="#f3ede4" stroke-opacity="0.6" stroke-width="1.6" />}
  {s.base && <ellipse cx="50" cy={s.base[0]} rx={s.base[1]} ry="2.4" fill="#fff" fill-opacity="0.05" stroke="#f3ede4" stroke-opacity="0.6" stroke-width="1.2" />}

  {wheel && s.rim && (
    <g transform={`translate(${rx} ${ry})`}>
      <circle r="8.5" fill={wheel} />
      <circle r="6.8" fill={shade(wheel, 0.45)} />
      <g stroke={wheel} stroke-width="0.8">
        <path d="M-6.8 0 L6.8 0 M0 -6.8 L0 6.8 M-4.8 -4.8 L4.8 4.8 M-4.8 4.8 L4.8 -4.8" />
      </g>
    </g>
  )}
  {garnish === 'mint' && s.rim && (
    <g transform={`translate(${rx - 4} ${ry - 3})`} fill="#5fb36b">
      <ellipse rx="3.4" ry="7" transform="rotate(-35)" />
      <ellipse cx="5" cy="1" rx="3" ry="6.2" transform="rotate(25 5 1)" fill="#4a9a58" />
    </g>
  )}
  {garnish === 'pineapple' && s.rim && (
    <g transform={`translate(${rx} ${ry})`}>
      <path d="M-9 4 L9 4 L0 -8 Z" fill="#f2c64a" />
      <path d="M0 -8 L-4 -17 M0 -8 L0 -19 M0 -8 L4 -17" stroke="#4f9a4f" stroke-width="2.2" stroke-linecap="round" />
    </g>
  )}
  {garnish === 'cherry' && s.rim && (
    <g transform={`translate(${rx - 5} ${ry - 2})`}>
      <path d="M0 0 Q2 -8 7 -11" stroke="#6b8f3a" stroke-width="1" fill="none" />
      <circle r="4" fill="#b0122a" />
    </g>
  )}
  {garnish === 'passion' && s.rim && (
    <g transform={`translate(${rx} ${ry})`}>
      <circle r="8" fill="#5b2a4e" />
      <circle r="6.2" fill="#f2c230" />
      {[[-2, -2], [2, -1], [-1, 2], [2.5, 2.5], [-3, 1]].map(([x, y]) => <circle cx={x} cy={y} r="0.9" fill="#2a1a12" />)}
    </g>
  )}
  {garnish === 'coffee' && (
    <g fill="#3b2314">
      {[44, 50, 56].map((x) => <ellipse cx={x} cy={s.level + 0.6} rx="2.2" ry="1.4" />)}
    </g>
  )}
  {garnish === 'cinnamon' && (
    <g>
      <rect x="56" y={s.level - 22} width="3.4" height="30" rx="1.2" fill="#8a4b25" transform={`rotate(18 58 ${s.level})`} />
      {[[44, 0.5], [48, 1.2], [52, 0.3], [41, 1.4], [55, 1]].map(([x, y]) => <circle cx={x} cy={s.level + y} r="0.8" fill="#8a4b25" />)}
    </g>
  )}
</svg>
