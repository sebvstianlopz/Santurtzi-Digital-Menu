---
import DrinkMedia from './DrinkMedia.astro';
import Strength from './Strength.astro';
import Icon from './Icon.astro';
import type { Drink } from '../utils/drinks';
import type { Lang } from '../config/site';
import { t, tx, formatPrice } from '../i18n';

interface Props { drink: Drink; lang: Lang; byId: Map<string, Drink> }
const { drink, lang, byId } = Astro.props;
const d = t(lang);
const v = drink.data;
const name = tx(v.name, lang);
const titleId = `t-${drink.id}`;
const pairs = v.pairsWith.map((id) => byId.get(id)!).filter(Boolean);
---
<dialog class="sheet drink-sheet" id={`d-${drink.id}`} data-sheet={drink.id} aria-labelledby={titleId}>
  <span class="grabber" aria-hidden="true"></span>
  <button class="sheet-close" type="button" data-close aria-label={d.sheet.close}><Icon name="x" /></button>
  <div class="sheet-scroll">
    <div class="media hero">
      <DrinkMedia drink={drink} lang={lang} uid={`s-${drink.id}`} size="sheet" />
    </div>

    <div class="body">
      {(v.signature || v.seasonal || !v.available) && (
        <div class="badges">
          {!v.available && <span class="badge soldout">{d.badge.soldOut}</span>}
          {v.signature && <span class="badge">{d.badge.signature}</span>}
          {v.seasonal && <span class="badge seasonal">{d.badge.seasonal}</span>}
        </div>
      )}
      <div class="title-row">
        <h2 class="serif" id={titleId}>{name}</h2>
        <p class="price">{formatPrice(v.price, lang)}{v.size && <span class="size"> · {v.size}</span>}</p>
      </div>
      <p class="unique serif">{tx(v.unique, lang)}</p>
      <p class="desc">{tx(v.description, lang)}</p>

      <dl class="facts">
        <div>
          <dt>{d.strengthLabel}</dt>
          <dd><Strength level={v.strength} lang={lang} showLabel /></dd>
        </div>
        <div>
          <dt>{d.sheet.profile}</dt>
          <dd class="chips">{v.flavor.map((f) => <span class="chip">{d.flavor[f]}</span>)}</dd>
        </div>
        {v.base && (
          <div>
            <dt>{d.sheet.base}</dt>
            <dd>{tx(v.base, lang)}</dd>
          </div>
        )}
        <div>
          <dt>{d.sheet.glass}</dt>
          <dd>{d.glass[v.glass]}</dd>
        </div>
      </dl>

      <section class="block">
        <h3>{d.sheet.ingredients}</h3>
        <ul class="ingredients">
          {v.ingredients.map((i) => <li>{tx(i, lang)}</li>)}
        </ul>
        {v.contains.length > 0 && (
          <p class="contains"><strong>{d.sheet.contains}:</strong> {v.contains.map((a) => d.allergen[a]).join(', ')}</p>
        )}
      </section>

      {pairs.length > 0 && (
        <section class="block">
          <h3>{d.sheet.pairs}</h3>
          <ul class="pairs">
            {pairs.map((p) => (
              <li>
                <a href={`#${p.id}`} data-open={p.id} class="pair">
                  <span class="media pair-media"><DrinkMedia drink={p} lang={lang} uid={`p-${drink.id}-${p.id}`} size="mini" /></span>
                  <span class="pair-text">
                    <span class="pair-name serif">{tx(p.data.name, lang)}</span>
                    <span class="pair-why">{tx(p.data.unique, lang)}</span>
                  </span>
                  <span class="price">{formatPrice(p.data.price, lang)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>

  <div class="cta-bar">
    <div class="in-order">
      <button class="icon-btn" type="button" data-remove={drink.id} aria-label={d.remove}><Icon name="minus" /></button>
      <span class="qty" data-qty-label={drink.id} aria-live="polite"></span>
    </div>
    <button class="btn btn-primary cta" type="button" data-add={drink.id} disabled={!v.available}>
      <Icon name="plus" size={18} />
      <span>{v.available ? d.addToOrder : d.badge.soldOut}</span>
      {v.available && <span class="cta-price">{formatPrice(v.price, lang)}</span>}
    </button>
  </div>
</dialog>

<style>
  .hero { aspect-ratio: 4 / 3; max-height: 44dvh; width: 100%; }
  .body { padding: 18px var(--gutter) 24px; display: flex; flex-direction: column; gap: 14px; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  h2 { font-size: 30px; font-weight: 560; letter-spacing: -0.01em; }
  .title-row .price { font-size: 22px; }
  .size { color: var(--faint); font-size: 14px; font-weight: 600; }
  .unique { font-size: 18px; line-height: 1.4; font-style: italic; color: var(--text); font-weight: 380; }
  .desc { color: var(--muted); font-size: 15px; }

  .facts {
    margin: 4px 0 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 1px;
    border-radius: var(--radius-sm); overflow: hidden;
    background: var(--line);
  }
  .facts > div { background: var(--surface-2); padding: 10px 12px; display: flex; flex-direction: column; gap: 4px; }
  dt { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }
  dd { margin: 0; font-size: 14px; font-weight: 600; }
  dd.chips { display: flex; flex-wrap: wrap; gap: 4px; }

  .block { display: flex; flex-direction: column; gap: 10px; padding-top: 4px; }
  h3 { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .ingredients { display: flex; flex-direction: column; }
  .ingredients li {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 15px;
  }
  .ingredients li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); flex: none; }
  .contains { font-size: 14px; color: var(--danger); }
  .contains strong { font-weight: 700; }

  .pairs { display: flex; flex-direction: column; gap: 8px; }
  .pair {
    display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 12px;
    padding: 8px 12px 8px 8px; border-radius: var(--radius-sm);
    background: var(--surface-2); text-decoration: none;
  }
  .pair-media { width: 56px; height: 56px; border-radius: 10px; }
  .pair-text { min-width: 0; display: flex; flex-direction: column; }
  .pair-name { font-size: 16px; font-weight: 560; }
  .pair-why { font-size: 12.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pair .price { font-size: 14px; }

  .cta-bar {
    display: flex; align-items: center; gap: 12px;
    padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .in-order { display: none; align-items: center; gap: 10px; }
  .drink-sheet[data-count] .in-order { display: flex; }
  .qty { font-size: 14px; font-weight: 700; color: var(--accent); white-space: nowrap; }
  .cta { flex: 1; }
  .cta-price { opacity: 0.75; font-variant-numeric: tabular-nums; }
  .cta-price::before { content: '·'; margin-right: 8px; }
</style>
