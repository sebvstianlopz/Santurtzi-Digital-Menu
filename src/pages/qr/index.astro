---
/**
 * Printable table card with the menu QR code, in the style of the printed menu.
 * Prints at 4×6 in; one per table and one at the bar.
 */
import QRCode from 'qrcode';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { menuPath } from '../../i18n';
import logo from '../../assets/logo.webp';
import sirenas from '../../assets/sirenas.png';
import esquina from '../../assets/esquina.png';

const url = new URL(menuPath('es'), Astro.site).href;
const svg = await QRCode.toString(url, { type: 'svg', errorCorrectionLevel: 'M', margin: 0, color: { dark: '#100c0a', light: '#0000' } });
const corner = await getImage({ src: esquina, width: 140, format: 'webp' });
---
<Base lang="es" title="Santurtzi La Cerra · Código QR de la carta" noindex>
  <div class="toolbar">
    <p>Tarjeta para mesas, 4×6 in. El código abre <a href={url}>{url}</a></p>
    <button class="pill pill-solid" type="button" onclick="window.print()"><Icon name="printer" size={16} />Imprimir</button>
  </div>

  <article class="card-qr">
    <div class="frame" aria-hidden="true" style={`--corner:url(${corner.src})`}><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
    <div class="logo-wrap">
      <Image class="ghost" src={sirenas} alt="" widths={[480]} sizes="240px" />
      <Image class="logo" src={logo} alt={site.fullName} widths={[400]} sizes="200px" />
    </div>
    <div class="qr" set:html={svg} />
    <p class="scan display">Escanea la carta</p>
    <p class="mono scan-en">Scan the menu</p>
    <p class="mono where">{site.area}</p>
  </article>
</Base>

<style>
  .toolbar { max-width: 720px; margin: 0 auto; padding: 20px 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; color: var(--cream-dim); font-size: 14px; }
  .toolbar a { color: var(--gold); word-break: break-all; }
  .card-qr {
    position: relative; width: 4in; max-width: calc(100vw - 32px); aspect-ratio: 4 / 6;
    margin: 8px auto 48px; padding: 0.5in 0.4in 0.4in;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    background: radial-gradient(ellipse 90% 50% at 50% 18%, #2a1c14, #100c0a 72%);
    color: var(--cream); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    print-color-adjust: exact; -webkit-print-color-adjust: exact;
  }
  .frame { position: absolute; inset: 8px; pointer-events: none; }
  .frame::before { content: ''; position: absolute; inset: 1px; border: 1px solid rgba(212, 176, 112, 0.7); }
  .frame i { position: absolute; width: 56px; height: 56px; background: var(--corner) 0 0 / 100% 100% no-repeat; }
  .frame .tl { top: 0; left: 0; }
  .frame .tr { top: 0; right: 0; transform: scaleX(-1); }
  .frame .bl { bottom: 0; left: 0; transform: scaleY(-1); }
  .frame .br { bottom: 0; right: 0; transform: scale(-1, -1); }
  .logo-wrap { position: relative; display: grid; place-items: center; padding: 18px 0 8px; }
  .logo-wrap :global(.ghost) { position: absolute; left: 50%; top: 50%; width: 240px; max-width: none; height: auto; transform: translate(-50%, -50%); opacity: 0.16; }
  .logo-wrap :global(.logo) { position: relative; width: 190px; height: auto; }
  .qr { width: 56%; margin: 18px 0 14px; padding: 10px; background: var(--cream); border-radius: 6px; }
  .qr :global(svg) { width: 100%; height: auto; }
  .scan { font-size: 28px; line-height: 1.1; }
  .scan-en { color: var(--gold); margin-top: 4px; }
  .where { margin-top: auto; color: var(--cream-dim); font-size: 10px; }
  @media print {
    @page { size: 4in 6in; margin: 0; }
    :global(body) { background: #100c0a !important; }
    .toolbar { display: none; }
    .card-qr { width: 4in; height: 6in; max-width: none; margin: 0; box-shadow: none; }
  }
</style>
