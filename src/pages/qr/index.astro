---
/**
 * Printable table card with the menu QR code. Print it at 4×6 in (or let the printer scale it),
 * one per table and one at the bar.
 */
import QRCode from 'qrcode';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { menuPath } from '../../i18n';

const url = new URL(menuPath('es'), Astro.site).href;
const svg = await QRCode.toString(url, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 0,
  color: { dark: '#111111', light: '#0000' },
});
---
<Base lang="es" title="Santurtzi · Código QR del menú" noindex>
  <div class="toolbar">
    <p>Tarjeta para mesas · imprime a 4×6 in. El código abre <a href={url}>{url}</a></p>
    <button class="btn btn-primary" type="button" onclick="window.print()"><Icon name="printer" size={18} />Imprimir</button>
  </div>

  <article class="card-qr">
    <p class="eyebrow">Bar de copas · {site.street}</p>
    <h1 class="serif">{site.name}</h1>
    <div class="qr" set:html={svg} />
    <p class="scan serif">Escanea el menú</p>
    <p class="scan-en">Scan the menu</p>
    <p class="what">Fotos, ingredientes y precios de cada trago.<br />Photos, ingredients &amp; prices for every drink.</p>
    <p class="url">{url.replace(/^https?:\/\//, '')}</p>
  </article>
</Base>

<style>
  .toolbar {
    max-width: 720px; margin: 0 auto; padding: 20px 16px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    color: var(--muted); font-size: 14px;
  }
  .toolbar a { color: var(--accent); word-break: break-all; }
  .card-qr {
    width: 4in; max-width: calc(100vw - 32px); aspect-ratio: 4 / 6;
    margin: 8px auto 48px; padding: 0.4in 0.35in;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    background: #f6f1e7; color: #111;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #5b554c; }
  h1 { font-size: 46px; font-weight: 500; letter-spacing: -0.02em; margin-top: 6px; }
  .qr { width: 62%; margin: 22px 0 18px; padding: 10px; background: #fff; border-radius: 10px; }
  .qr :global(svg) { width: 100%; height: auto; }
  .scan { font-size: 24px; font-weight: 560; }
  .scan-en { font-size: 14px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #5b554c; margin-top: 2px; }
  .what { margin-top: auto; font-size: 11px; line-height: 1.5; color: #5b554c; }
  .url { margin-top: 8px; font-size: 9px; color: #5b554c; word-break: break-all; }

  @media print {
    @page { size: 4in 6in; margin: 0; }
    :global(body) { background: #fff !important; }
    .toolbar { display: none; }
    .card-qr { width: 4in; height: 6in; max-width: none; margin: 0; border-radius: 0; box-shadow: none; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  }
</style>
